{
  "name": "frontend-task",
  "private": true,
  "homepage": "https://tabdeal-frontend-task.vercel.app",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "postinstall": "nuxt prepare",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "nuxt": "^3.21.11",
    "vue": "^3.5.40",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.3",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "h3": "^1.15.11",
    "happy-dom": "^20.14.5",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/check-node.mjs && pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  }
}
